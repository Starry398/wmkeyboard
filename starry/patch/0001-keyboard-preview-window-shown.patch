+    /**
+     * True while the keyboard's own window is on screen, as the keyboard
+     * itself last said. Same process, so a plain flow carries it.
+     *
+     * The settings app's keyboard test field closes with the keyboard. It used
+     * to learn that from the window's insets alone, and a floating or
+     * freeform window that the system moves clear of the keyboard is never
+     * handed a keyboard inset, so the field never saw the keyboard come and
+     * stayed open, stuck over the screen, after the keyboard had gone.
+     */
+    val windowShown: StateFlow<Boolean> = _windowShown.asStateFlow()
+
+    /** Set by the keyboard as its window shows and hides; see [windowShown]. */
+    fun setWindowShown(value: Boolean) {
